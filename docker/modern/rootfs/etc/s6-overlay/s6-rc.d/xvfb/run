#!/command/execlineb -P
with-contenv
importas -D 1000 USER_ID USER_ID
importas -D 1000 GROUP_ID GROUP_ID
s6-applyuidgid -u ${USER_ID} -g ${GROUP_ID} -G ${GROUP_ID}
/bin/bash -c "
exec 2>&1

# Start Xvfb on display :99 with configured resolution
exec Xvfb :99 -screen 0 ${DISPLAY_WIDTH:-1280}x${DISPLAY_HEIGHT:-720}x24 -ac +extension GLX +render -noreset
"
