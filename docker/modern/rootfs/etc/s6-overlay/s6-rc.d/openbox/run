#!/command/execlineb -P
with-contenv
importas -D 1000 USER_ID USER_ID
importas -D 1000 GROUP_ID GROUP_ID
s6-applyuidgid -u ${USER_ID} -g ${GROUP_ID} -G ${GROUP_ID}
/bin/bash -c "
exec 2>&1

echo 'Waiting for X server...'
while ! xdpyinfo -display :99 >/dev/null 2>&1; do
    sleep 0.5
done
echo 'X server ready, starting Openbox'

exec openbox --config-file /etc/xdg/openbox/rc.xml
"
